# =========================================
# Database Configuration
# =========================================
DB_NAME=realestate
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# Database URL (constructed from above variables)
DATABASE_URL=postgresql://postgres:postgres@db:5432/realestate

# =========================================
# Backend Configuration
# =========================================
BACKEND_PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=dev_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRATION=900

# Refresh Token Configuration
REFRESH_TOKEN_SECRET=dev_refresh_secret_change_in_production_min_32_chars
REFRESH_TOKEN_EXPIRATION=604800

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# =========================================
# Frontend Configuration
# =========================================
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000

# =========================================
# Optional: Third-party Services
# =========================================
# STRIPE_API_KEY=sk_test_xxxx
# AWS_ACCESS_KEY_ID=xxxx
# AWS_SECRET_ACCESS_KEY=xxxx
# S3_BUCKET=xxxx
