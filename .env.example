# Root Environment Template
# Copy to .env.local for development or .env.prod for production
# DO NOT commit .env.local or .env.prod to version control

# Environment
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/boilerplate?schema=public

# Backend Configuration
JWT_SECRET=your_jwt_secret_minimum_32_characters_dev
JWT_EXPIRATION=900
REFRESH_TOKEN_SECRET=your_refresh_secret_minimum_32_chars_dev
REFRESH_TOKEN_EXPIRATION=604800
BACKEND_PORT=3000

# Frontend Configuration
VITE_API_URL=http://localhost:3000
FRONTEND_PORT=5173
