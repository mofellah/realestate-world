# =========================================
# Root Environment Template
# Copy to .env.local for development or .env.prod for production
# DO NOT commit .env.local or .env.prod to version control
# =========================================

# =========================================
# Environment
# =========================================
NODE_ENV=development

# =========================================
# Database Configuration (PostgreSQL 18 + PostGIS)
# =========================================
DB_NAME=realestate
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/realestate?schema=public

# =========================================
# Backend Configuration (NestJS + Fastify)
# =========================================
BACKEND_PORT=3000

# Authentication & Security
# JWT secret must be at least 32 characters
JWT_SECRET=dev_jwt_secret_32_chars_minimum_123456789abc
JWT_EXPIRATION=900

# Refresh token secret must be at least 32 characters
REFRESH_TOKEN_SECRET=dev_refresh_secret_32_chars_min_123456789abc
REFRESH_TOKEN_EXPIRATION=604800

# =========================================
# Frontend Configuration (React 19 + Vite)
# =========================================
FRONTEND_PORT=8080
FRONTEND_URL=http://localhost:8080
VITE_API_URL=http://localhost:3000

# =========================================
# Payment Integration (Stripe)
# =========================================
STRIPE_API_KEY=your-stripe-secret-key-here
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key-here

# =========================================
# Email Configuration (Future)
# =========================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-email-password

# =========================================
# Map Service (Mapbox or Google Maps)
# =========================================
# MAPBOX_API_KEY=your-mapbox-api-key-here
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# =========================================
# File Storage (Future - AWS S3 or similar)
# =========================================
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET=realestate-photos
# AWS_REGION=eu-west-1

# =========================================
# Redis Cache (Future)
# =========================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

