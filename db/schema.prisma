// Prisma schema for Real Estate MVP
// Complete inheritance and polymorphic design
// Multi-country support (Belgium, Holland, Switzerland)
// PostgreSQL 18 with PostGIS for geospatial queries
// Last Updated: 2026-01-28 (Design Complete - All User Decisions Applied)
//
// DESIGN DECISIONS APPLIED:
// 1. Person: Generic table (firstName, lastName, email) → users reference it
// 2. Amenity: Separate type-specific child tables (Hospital, School, Restaurant, TransitStop)
// 3. Subject: Base Subject + ListingSubject (extensible to PropertySubject, InquirySubject)
// 4. UserRole: Simplified to user | admin only (contextual roles via AgencyRole)
// 5. ExternalPropertyOwner: Full documentation fields
// 6. PaymentTerms: Separate table for flexible per-listing-type parameters

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  user
  admin
}

enum PropertyType {
  studio
  house
  apartment
  villa
  land
  room
  commercial
  other
}

enum ListingType {
  sale
  rental
  short_term
  lease
}

enum ListingStatus {
  draft
  published
  paused
  expired
}

enum PaymentTermType {
  onetime
  periodic
  composite
}

enum PaymentCompositionType {
  split          // Multiple parties split payment
  phased         // Payment in multiple phases
  combined       // Combination of different payment types
}

enum AgencyTierType {
  basic
  pro
  premium
}

enum AgencyRoleType {
  owner
  manager
  agent
  sales_manager
  support_agent
}

enum AmenityTypeEnum {
  hospital
  school
  park
  shopping
  restaurant
  cafe
  bank
  pharmacy
  gym
  public_transport
  library
  police
  fire_station
  supermarket
  gas_station
  other
}

enum SubscriptionStatus {
  active
  canceled
  suspended
  expired
}

enum SubscriptionTierName {
  local
  regional
  national
  premium
}

enum SubscriptionPlanType {
  individual
  organization
}

enum MessageType {
  inquiry
  response
}

enum ViewType {
  preview
  detail
}

enum SubjectType {
  listing
  property
  inquiry
}

enum GeoObjectType {
  point
  polygon
  multipolygon
  linestring
}

// ============================================================================
// 1. PERSON MODEL (Generic base - stores person reference)
// ============================================================================

model Person {
  id            String        @id @default(cuid())
  
  email         String        @unique
  phone         String?
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  user          User?         @relation("PersonToUser")
  physicalPerson PhysicalPerson?
  organization  Organization?
  ownedProperties Property[]   @relation("PropertyOwnerPerson")
  agency        Agency?       @relation("AgencyPerson")

  @@map("people")
}

// ============================================================================
// 1.1 PHYSICAL PERSON (Child of Person)
// ============================================================================

model PhysicalPerson {
  id            String        @id @default(cuid())
  personId      String        @unique
  person        Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  
  firstName     String
  lastName      String
  nationality   String?       // ISO country code
  
  // Address
  addressId     String?
  address       Address?      @relation("PhysicalPersonAddress", fields: [addressId], references: [id], onDelete: SetNull)
  
  // KYC/Verification
  idNumber      String?       @unique
  idType        String?       // passport, national_id, drivers_license
  idVerified    Boolean       @default(false)
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([personId])
  @@index([addressId])
  @@map("physical_people")
}

// ============================================================================
// 1.2 ORGANIZATION (Child of Person)
// ============================================================================

model Organization {
  id            String        @id @default(cuid())
  personId      String        @unique
  person        Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  
  businessName  String
  businessRegNumber String?
  taxId         String?
  registrationCountry String
  
  // Address
  addressId     String?
  address       Address?      @relation("OrganizationAddress", fields: [addressId], references: [id], onDelete: SetNull)
  
  // Contact person in organization
  contactFirstName String?
  contactLastName String?
  contactTitle  String?       // CEO, Manager, etc.
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([personId])
  @@index([addressId])
  @@index([registrationCountry])
  @@map("organizations")
}


// ============================================================================
// 2. USER MODEL (Simplified roles)
// ============================================================================
// DECISION: User `name` field is OPTIONAL
// Rationale: Real estate system allows users to register with just email first,
// then complete profile later with Person/PhysicalPerson link. Optional name
// supports both quick registration and full profile completion workflows.

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  avatarUrl     String?
  name          String?       // Optional - user can register without name initially
  
  // Single role: user or admin (contextual roles via AgencyRole)
  // DECISION: Simple UserRole enum pattern (NOT RBAC with userRoles table)
  // Rationale: System uses user/admin for system-level permissions.
  // Fine-grained permissions managed through AgencyRole for agency context.
  // This keeps queries fast while still supporting complex agency hierarchies.
  role          UserRole      @default(user)
  
  isActive      Boolean       @default(true)
  country_code  String?
  
  // Link to Person (generic table)
  personId      String?       @unique
  person        Person?       @relation("PersonToUser", fields: [personId], references: [id], onDelete: SetNull)
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  refreshTokens RefreshToken[]
  properties    Property[]    @relation("PropertyOwner")
  listings      Listing[]     @relation("ListingCreator")
  sentMessages  Message[]     @relation("MessageSender")
  receivedMessages Message[]  @relation("MessageRecipient")
  agencyRoles   AgencyRole[]
  individualSubscription IndividualSubscriptionPlan?
  views         View[]        @relation("ViewerUser")

  @@index([email])
  @@index([role])
  @@index([country_code])
  @@map("users")
}

// ============================================================================
// 3. GEO OBJECT MODEL (Geographical data - points and simple polygons)
// ============================================================================
// DESIGN: GeoObject is for SIMPLE geographic features (points, user polygons)
// USE FOR: Address locations, amenity POIs, user-defined search areas
// DON'T USE FOR: Administrative boundaries (use Boundary model instead)
//
// PERFORMANCE: Point queries are fast with lat/lon index
// For complex administrative boundaries, use Boundary model with PostGIS geometry

model GeoObject {
  id            String        @id @default(cuid())
  type          GeoObjectType
  
  // Coordinates (for points) - INDEXED for fast spatial queries
  latitude      Float?
  longitude     Float?
  
  // For simple polygons/multipolygons (GeoJSON format)
  // Example: User-defined search area, property parcel
  geoJson       Json?
  
  // Bounding box for spatial indexing (denormalized for performance)
  // Calculated from geoJson or single point
  minLat        Float?
  minLon        Float?
  maxLat        Float?
  maxLon        Float?
  
  // Centroid (for distance calculations, map markers)
  centroidLat   Float?
  centroidLon   Float?
  
  name          String?
  metadata      Json?
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  addresses     Address[]     @relation("AddressGeoObject")
  amenities     Amenity[]     @relation("AmenityGeoObject")
  geographicalAreas GeographicalArea[] @relation("AreaGeoObject")

  @@index([type])
  @@index([latitude, longitude])
  @@index([minLat, minLon, maxLat, maxLon]) // Bounding box index
  @@index([centroidLat, centroidLon])       // Centroid index
  @@map("geo_objects")
}

// ============================================================================
// 4. ADDRESS MODEL (Street address - with optional geo reference)
// ============================================================================

model Address {
  id            String        @id @default(cuid())
  
  streetName    String
  streetNumber  String?
  unit          String?       // Apartment, suite number
  postalCode    String
  city          String
  region        String?       // State, province, region
  country_code  String
  
  // Link to geographical object (optional)
  geoObjectId   String?
  geoObject     GeoObject?    @relation("AddressGeoObject", fields: [geoObjectId], references: [id], onDelete: SetNull)
  
  metadata      Json?
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  properties    Property[]
  physicalPeople PhysicalPerson[] @relation("PhysicalPersonAddress")
  organizations Organization[] @relation("OrganizationAddress")

  @@index([postalCode])
  @@index([city])
  @@index([country_code])
  @@index([geoObjectId])
  @@unique([streetName, streetNumber, unit, postalCode, country_code])
  @@map("addresses")
}



// ============================================================================
// 5. PROPERTY MODEL (Asset - with ownership tracking)
// ============================================================================

model Property {
  id             String        @id @default(cuid())
  title          String
  description    String?
  
  // Address
  addressId      String
  address        Address       @relation(fields: [addressId], references: [id], onDelete: Cascade)
  
  // Ownership (reference to Person - can be user's person or external person)
  ownerPersonId  String
  ownerPerson    Person        @relation("PropertyOwnerPerson", fields: [ownerPersonId], references: [id], onDelete: Restrict)
  
  // Optional: Link to system user if owner is a registered user
  userId         String?       // Nullable if owner is not a system user
  user           User?         @relation("PropertyOwner", fields: [userId], references: [id], onDelete: SetNull)
  
  // Owner documentation (part of property docs)
  ownerDocumentUrl String?     // Contract, title deed, etc.
  
  // Property details
  propertyType   PropertyType
  bedrooms       Int?
  bathrooms      Int?
  surfaceArea    Float?        // Square meters
  gardenSize     Float?        // Square meters
  yearBuilt      Int?
  amenitiesList  String[]      // Array of amenity names
  metadata       Json?         // Extensible data
  
  // Hierarchy (sub-properties like garage)
  parentPropertyId String?
  parentProperty  Property?    @relation("PropertyHierarchy", fields: [parentPropertyId], references: [id], onDelete: SetNull)
  childProperties Property[]   @relation("PropertyHierarchy")
  
  isAvailable    Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  listings       Listing[]
  listingSubjects ListingSubject[]

  @@index([userId])
  @@index([ownerPersonId])
  @@index([addressId])
  @@index([propertyType])
  @@map("properties")
}

// ============================================================================
// 6. PAYMENT TERMS MODEL (Base - with inheritance)
// ============================================================================

model PaymentTerms {
  id            String        @id @default(cuid())
  
  termType      PaymentTermType  // onetime or periodic discriminator
  description   String?
  currency      String        @default("EUR")
  
  metadata      Json?
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations (polymorphic)
  onetimePayment OnetimePaymentTerm?
  periodicPayment PeriodicPaymentTerm?
  compositePayment CompositePaymentTerm?
  listings      Listing[]

  @@index([termType])
  @@map("payment_terms")
}

// ============================================================================
// 6.1 ONETIME PAYMENT TERM (Single payment)
// ============================================================================

model OnetimePaymentTerm {
  id            String        @id @default(cuid())
  paymentTermsId String       @unique
  paymentTerms  PaymentTerms  @relation(fields: [paymentTermsId], references: [id], onDelete: Cascade)
  
  amount        Float
  
  // For installment options
  installmentCount Int?
  installmentAmount Float?
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([paymentTermsId])
  @@map("onetime_payment_terms")
}

// ============================================================================
// 6.2 PERIODIC PAYMENT TERM (Recurring payments)
// ============================================================================

model PeriodicPaymentTerm {
  id            String        @id @default(cuid())
  paymentTermsId String       @unique
  paymentTerms  PaymentTerms  @relation(fields: [paymentTermsId], references: [id], onDelete: Cascade)
  
  amountPerPeriod Float
  periodType    String        // "monthly", "quarterly", "biannual", "annual", "per_night", "per_week"
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([paymentTermsId])
  @@map("periodic_payment_terms")
}

// ============================================================================
// 6.3 COMPOSITE PAYMENT TERM (Combining multiple payment terms)
// ============================================================================

model CompositePaymentTerm {
  id            String        @id @default(cuid())
  paymentTermsId String       @unique
  paymentTerms  PaymentTerms  @relation(fields: [paymentTermsId], references: [id], onDelete: Cascade)
  
  compositionType PaymentCompositionType
  
  // References to component payment terms (stored as JSON array of IDs)
  componentTerms Json         // Array of {paymentTermId: string, percentage?: number, phase?: number}
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([paymentTermsId])
  @@map("composite_payment_terms")
}

// ============================================================================
// 7. LISTING MODEL (Base - Polymorphic with type-specific children)
// ============================================================================

// ============================================================================
// 7. LISTING MODEL (Property listing with polymorphic type-specific data)
// ============================================================================
// LISTING DESIGN DECISIONS:
// 1. ListingType enum: sale, rental, short_term, lease
//    - sale: One-time purchase transactions
//    - rental: Long-term residential rentals (6+ months)
//    - short_term: Vacation/temporary stays (days/weeks)
//    - lease: Commercial/industrial long-term leases (years)
//
// 2. Address: REFERENCED via Property model (not embedded in Listing)
//    - Rationale: Property has addressId, Listing references Property
//    - One Property can have multiple Listings (sale + rental simultaneously)
//    - Address normalization prevents data duplication
//
// 3. Property-to-Listing: One-to-Many relationship
//    - One Property can have many Listings (different types, time periods)
//    - Example: Property for sale AND for rent while awaiting buyer
//
// 4. Required Fields:
//    - propertyId: REQUIRED (every listing must reference a property)
//    - createdBy: REQUIRED (audit trail of who created listing)
//    - type: REQUIRED (discriminator for polymorphic child tables)
//    - status: REQUIRED (draft, published, paused, expired)
//    - paymentTermsId: REQUIRED (pricing/payment structure)
//
// 5. Optional Fields:
//    - visibilityStart/End: Optional (for scheduled publishing)
//    - publishedAt: Optional (set when status becomes 'published')

model Listing {
  id             String        @id @default(cuid())
  
  // Discriminator for type
  type           ListingType
  
  propertyId     String
  property       Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  // Who created this listing (user or agent)
  createdBy      String
  creator        User          @relation("ListingCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  
  // Payment terms (moved from child models)
  paymentTermsId String
  paymentTerms   PaymentTerms  @relation(fields: [paymentTermsId], references: [id], onDelete: Restrict)
  
  status         ListingStatus @default(draft)
  
  visibilityStart DateTime?
  visibilityEnd DateTime?
  visibilityDays Int?
  
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations (polymorphic type-specific data)
  saleListing    SaleListing?  @relation("ListingToSale")
  rentalListing  RentalListing? @relation("ListingToRental")
  shortTermListing ShortTermListing? @relation("ListingToShortTerm")
  leaseListing   LeaseListing? @relation("ListingToLease")
  
  // Subjects and views
  listingSubjects ListingSubject[]
  views          View[]

  @@index([propertyId])
  @@index([createdBy])
  @@index([paymentTermsId])
  @@index([status])
  @@index([type])
  @@index([visibilityEnd])
  @@map("listings")
}

// ============================================================================
// 7.1 SALE LISTING (Type-specific fields for sale)
// ============================================================================

model SaleListing {
  id             String        @id @default(cuid())
  listingId      String        @unique
  listing        Listing       @relation("ListingToSale", fields: [listingId], references: [id], onDelete: Cascade)
  
  condition      String?       // excellent, good, fair, needs_work
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([listingId])
  @@map("sale_listings")
}

// ============================================================================
// 7.2 RENTAL LISTING (Type-specific fields for rental)
// ============================================================================

model RentalListing {
  id             String        @id @default(cuid())
  listingId      String        @unique
  listing        Listing       @relation("ListingToRental", fields: [listingId], references: [id], onDelete: Cascade)
  
  leaseTermMonths Int?         // Minimum lease length
  utilitiesIncluded Boolean    @default(false)
  utilitiesDetails String?
  petFriendly    Boolean       @default(false)
  petDetails     String?
  furnishingStatus String?     // unfurnished, semi_furnished, furnished
  
  // Deposit/security requirements
  depositRequired Float?
  depositPercent Float?       // Percentage of monthly rent
  
  autoRenew      Boolean       @default(false)
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([listingId])
  @@map("rental_listings")
}

// ============================================================================
// 7.3 SHORT-TERM LISTING (Type-specific fields for vacation/short stays)
// ============================================================================

model ShortTermListing {
  id             String        @id @default(cuid())
  listingId      String        @unique
  listing        Listing       @relation("ListingToShortTerm", fields: [listingId], references: [id], onDelete: Cascade)
  
  minStayNights  Int?          // Minimum stay (3, 7, 30)
  maxGuestsAllowed Int?
  
  cancellationPolicy String?   // flexible, moderate, strict, super_strict
  checkInTime    String?       // HH:MM format
  checkOutTime   String?       // HH:MM format
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([listingId])
  @@map("short_term_listings")
}

// ============================================================================
// 7.4 LEASE LISTING (Type-specific fields for commercial/long-term)
// ============================================================================

model LeaseListing {
  id             String        @id @default(cuid())
  listingId      String        @unique
  listing        Listing       @relation("ListingToLease", fields: [listingId], references: [id], onDelete: Cascade)
  
  leaseType      String?       // residential, commercial, industrial, mixed_use
  leaseTermYears Int?          // Standard lease duration
  renewalOptions Boolean       @default(false)
  securityDeposit Float?
  commercialUseAllowed Boolean @default(false)
  businessType   String?       // If commercial use allowed
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([listingId])
  @@map("lease_listings")
}

// ============================================================================
// 8. AGENCY MODEL (Real estate agency)
// ============================================================================

model Agency {
  id             String        @id @default(cuid())
  
  // Agency IS a Person (Organization)
  personId       String        @unique
  person         Person        @relation("AgencyPerson", fields: [personId], references: [id], onDelete: Cascade)
  
  tier           AgencyTierType @default(basic)
  
  profileImageUrl String?
  description    String?
  
  maxAgents      Int           @default(5)
  maxListings    Int           @default(50)
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  employees      AgencyRole[]
  subscriptions  OrganizationSubscriptionPlan[]

  @@index([personId])
  @@index([tier])
  @@map("agencies")
}

// ============================================================================
// 8.1 AGENCY ROLE (Contextual roles for users in agencies)
// ============================================================================

model AgencyRole {
  id            String        @id @default(cuid())
  
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  agencyId      String
  agency        Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  
  role          AgencyRoleType
  permissions   Json?         // Custom permissions per role
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([userId, agencyId])
  @@index([agencyId])
  @@map("agency_roles")
}

// ============================================================================
// 9. GEOGRAPHICAL AREA MODEL (Market-specific zones)
// ============================================================================

model GeographicalArea {
  id             String        @id @default(cuid())
  name           String
  code           String        @unique
  description    String?
  
  // Hierarchy for nested areas
  parentAreaId   String?
  parentArea     GeographicalArea? @relation("AreaHierarchy", fields: [parentAreaId], references: [id], onDelete: SetNull)
  childAreas     GeographicalArea[] @relation("AreaHierarchy")
  
  // Geographical representation
  geoObjectId    String?
  geoObject      GeoObject?    @relation("AreaGeoObject", fields: [geoObjectId], references: [id], onDelete: SetNull)
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([code])
  @@index([geoObjectId])
  @@map("geographical_areas")
}

// ============================================================================
// 10. BOUNDARY TYPE MODEL (Country-Specific Administrative Divisions)
// ============================================================================
// 
// Purpose: Define boundary types per country (e.g., prefecture in Japan, 
//          state in US, province in Canada, département in France)
// 
// Examples:
//   - Japan: country → prefecture (都道府県) → city (市) → ward (区)
//   - France: country → région → département → commune
//   - Belgium: country → region → province → municipality
//   - US: country → state → county → city
// ============================================================================

model BoundaryType {
  id               String        @id @default(cuid())
  
  // Type identification
  code             String        // Internal code: 'prefecture', 'state', 'municipality', etc.
  name             String        // Display name in English
  localName        String?       // Display name in local language (e.g., "都道府県" for prefecture)
  pluralName       String?       // Plural form (e.g., "prefectures", "states")
  
  // Country-specific
  countryCode      String        // ISO 3166-1 alpha-2 (BE, FR, JP, US, etc.)
  
  // Hierarchy (level in administrative structure)
  level            Int           // 0=country, 1=top-level division, 2=second level, etc.
  parentTypeId     String?       // Parent boundary type in hierarchy
  parentType       BoundaryType? @relation("BoundaryTypeHierarchy", fields: [parentTypeId], references: [id], onDelete: SetNull)
  childTypes       BoundaryType[] @relation("BoundaryTypeHierarchy")
  
  // OSM mapping (for data import)
  osmAdminLevel    Int?          // OSM admin_level (2=country, 4=state, 7=municipality, etc.)
  osmBoundaryTag   String?       // OSM boundary tag value (e.g., 'administrative')
  
  // Display and search
  abbreviation     String?       // Short form (e.g., "Pref." for prefecture, "Dept." for département)
  description      String?       // Explanation of this boundary type
  icon             String?       // Icon identifier for UI
  color            String?       // Color for map visualization
  
  // Flags
  isOfficial       Boolean       @default(true)  // Official government boundary vs custom
  isActive         Boolean       @default(true)  // Enable/disable without deleting
  
  // Usage
  boundaries       Boundary[]    @relation("BoundaryTypeBoundaries")
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([code, countryCode]) // Unique code per country
  @@index([countryCode])
  @@index([level])
  @@index([osmAdminLevel])
  @@map("boundary_types")
}

// ============================================================================
// 11. BOUNDARY MODEL (Unified administrative and non-administrative boundaries)
// ============================================================================
// DESIGN: Boundary has EMBEDDED geometry (not via GeoObject reference)
// RATIONALE: 
// 1. Performance: Avoid JOIN for spatial queries (PostGIS index locality)
// 2. Query patterns: Boundaries are queried BY geometry frequently
// 3. Data integrity: Geometry + metadata together prevents orphaned records
// 4. PostGIS optimization: ST_Contains, ST_Intersects work best on same table
//
// SPATIAL INDEXES: Use PostGIS GIST index on geometry column in migration
// BOUNDING BOX: Denormalized for fast pre-filtering before expensive ST_Contains
//
// Example migration SQL:
// CREATE INDEX idx_boundaries_geometry ON boundaries USING GIST (geometry);
// CREATE INDEX idx_boundaries_bbox ON boundaries (minLat, minLon, maxLat, maxLon);

model Boundary {
  id             String        @id @default(cuid())
  name           String
  nameSlug       String        // URL-friendly version
  alternateNames String[]      // Common variations, abbreviations, translations
  
  // Type and classification (references BoundaryType table)
  boundaryTypeId String
  boundaryType   BoundaryType  @relation("BoundaryTypeBoundaries", fields: [boundaryTypeId], references: [id], onDelete: Restrict)
  officialCode   String?       // OSM ID, FIPS code, postal code, etc.
  country_code   String
  
  // Hierarchy (self-referential for multi-level boundaries)
  parentId       String?
  parent         Boundary?     @relation("BoundaryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Boundary[]    @relation("BoundaryHierarchy")
  
  // Denormalized hierarchy fields for fast queries (avoid N+1)
  cityName       String?       // Nearest city
  regionName     String?       // State/province/region
  countryName    String?       // Country name
  
  // PostGIS geometry (native PostGIS type with GIST index)
  // Prisma maps this as Bytes, but in PostgreSQL it's: geometry(MultiPolygon, 4326)
  // Migration 20260203_convert_boundary_geometry.sql converted from bytea to geometry
  // Spatial index: boundaries_geometry_gist_idx for fast ST_Within, ST_Contains queries
  geometry       Bytes?        // PostGIS geometry(MultiPolygon, 4326) - mapped as Bytes in Prisma
  
  // Bounding box for fast pre-filtering (indexed, denormalized from geometry)
  // Use for: "Find boundaries near point" before expensive ST_Contains
  minLat         Float?
  minLon         Float?
  maxLat         Float?
  maxLon         Float?
  
  // Centroid for distance calculations and point-in-polygon fallback
  // Use for: "Nearest boundary", map markers, distance sorting
  centroidLat    Float?
  centroidLon    Float?
  
  // Metadata and statistics
  population     Int?          // Population count (from OSM or census)
  area_sqkm      Float?        // Area in square kilometers
  propertyCount  Int           @default(0) // Cached property count (updated nightly)
  avgPrice       Float?        // Cached average listing price (updated nightly)
  
  // Search optimization
  searchRank     Int           @default(0) // Popularity rank (0-1000, higher = more popular)
  isPopular      Boolean       @default(false) // Featured/popular flag (top 100 boundaries)
  isOfficial     Boolean       @default(true) // Official (OSM, census) vs user-defined
  
  // Flexible metadata storage
  metadata       Json?         // OSM tags, demographic data, boundary source, etc.
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([boundaryTypeId])
  @@index([country_code])
  @@index([nameSlug])
  @@index([searchRank])
  @@index([isPopular])
  @@index([cityName])
  @@index([minLat, minLon, maxLat, maxLon]) // Bounding box index for spatial pre-filter
  @@index([centroidLat, centroidLon])       // Centroid index for distance queries
  @@index([parentId])
  @@unique([nameSlug, boundaryTypeId, country_code]) // Unique slug per type per country
  @@map("boundaries")
}

// ============================================================================
// 11. AMENITY MODEL (Base - POI with type-specific children)
// ============================================================================

model Amenity {
  id             String        @id @default(cuid())
  name           String
  type           AmenityTypeEnum
  
  // Geographical location
  geoObjectId    String
  geoObject      GeoObject     @relation("AmenityGeoObject", fields: [geoObjectId], references: [id], onDelete: Cascade)
  
  // Contact info
  address        String?
  city           String?
  country_code   String
  phone          String?
  website        String?
  openingHours   String?
  
  // Rating/Review
  avgRating      Float?
  reviewCount    Int?
  
  metadata       Json?
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations (type-specific)
  hospital       HospitalAmenity?
  school         SchoolAmenity?
  restaurant     RestaurantAmenity?
  transitStop    TransitStopAmenity?

  @@index([type])
  @@index([geoObjectId])
  @@index([city])
  @@index([country_code])
  @@map("amenities")
}

// ============================================================================
// 11.1 HOSPITAL AMENITY (Type-specific for hospitals)
// ============================================================================

model HospitalAmenity {
  id             String        @id @default(cuid())
  amenityId      String        @unique
  amenity        Amenity       @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  
  specializations String[]
  beds           Int?
  emergencyDept  Boolean       @default(false)
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([amenityId])
  @@map("hospital_amenities")
}

// ============================================================================
// 11.2 SCHOOL AMENITY (Type-specific for schools)
// ============================================================================

model SchoolAmenity {
  id             String        @id @default(cuid())
  amenityId      String        @unique
  amenity        Amenity       @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  
  grades         Int[]
  type           String?       // public, private, charter
  pupils         Int?
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([amenityId])
  @@map("school_amenities")
}

// ============================================================================
// 11.3 RESTAURANT AMENITY (Type-specific for restaurants)
// ============================================================================

model RestaurantAmenity {
  id             String        @id @default(cuid())
  amenityId      String        @unique
  amenity        Amenity       @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  
  cuisine        String?
  seatsAvailable Int?
  priceRange     String?       // €, $$, $$$, $$$$
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([amenityId])
  @@map("restaurant_amenities")
}

// ============================================================================
// 11.4 TRANSIT STOP AMENITY (Type-specific for public transport)
// ============================================================================

model TransitStopAmenity {
  id             String        @id @default(cuid())
  amenityId      String        @unique
  amenity        Amenity       @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  
  lines          String[]      // Bus routes, metro lines
  frequency      String?       // Every X minutes
  accessibility  Boolean       @default(false)
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([amenityId])
  @@map("transit_stop_amenities")
}

// ============================================================================
// 12. SUBJECT MODEL (Base - for conversations)
// ============================================================================

model Subject {
  id             String        @id @default(cuid())
  subjectType    SubjectType   // listing, property, inquiry
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  listingSubject ListingSubject?
  messages       Message[]

  @@index([subjectType])
  @@map("subjects")
}

// ============================================================================
// 12.1 LISTING SUBJECT (Conversation about a listing)
// ============================================================================

model ListingSubject {
  id             String        @id @default(cuid())
  subjectId      String        @unique
  subject        Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  listingId      String
  listing        Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  
  propertyId     String
  property       Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([listingId])
  @@index([subjectId])
  @@index([listingId])
  @@map("listing_subjects")
}

// ============================================================================
// 13. MESSAGE MODEL (Linked to Subject for polymorphic conversations)
// ============================================================================

model Message {
  id             String        @id @default(cuid())
  
  senderId       String
  sender         User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  
  recipientId    String
  recipient      User          @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  
  // Subject polymorphism (can be about listing, property, inquiry, etc.)
  subjectId      String?
  subject        Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  
  // Thread for conversation grouping
  threadId       String?
  
  messageType    MessageType   @default(inquiry)
  
  subject_line   String?
  body           String
  
  // For agency distribution
  distributionList Json?       // Array of user IDs for forwarding
  
  isRead         Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@index([senderId])
  @@index([recipientId])
  @@index([subjectId])
  @@index([threadId])
  @@index([createdAt])
  @@map("messages")
}

// ============================================================================
// 14. VIEW MODEL (Tracking listing views for analytics)
// ============================================================================

model View {
  id             String        @id @default(cuid())
  
  listingId      String
  listing        Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  
  viewerId       String?
  viewer         User?         @relation("ViewerUser", fields: [viewerId], references: [id], onDelete: SetNull)
  
  viewType       ViewType      @default(preview)
  
  ipAddress      String?       // Hashed for privacy
  userAgent      String?
  
  timestamp      DateTime      @default(now())

  @@index([listingId])
  @@index([viewerId])
  @@index([timestamp])
  @@map("views")
}

// ============================================================================
// 15. SUBSCRIPTION PLAN MODEL (Base - Polymorphic)
// ============================================================================

model SubscriptionPlan {
  id             String        @id @default(cuid())
  
  planType       SubscriptionPlanType
  tierName       SubscriptionTierName
  monthlyPrice   Float
  features       Json?
  
  status         SubscriptionStatus @default(active)
  renewalDate    DateTime
  canceledAt     DateTime?
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  individualPlan IndividualSubscriptionPlan?
  organizationPlan OrganizationSubscriptionPlan?

  @@index([planType])
  @@index([status])
  @@index([renewalDate])
  @@map("subscription_plans")
}

// ============================================================================
// 15.1 INDIVIDUAL SUBSCRIPTION PLAN (User-level subscription)
// ============================================================================

model IndividualSubscriptionPlan {
  id             String        @id @default(cuid())
  planId         String        @unique
  plan           SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  maxListingsActive Int
  maxAreas       Int
  hasAdvancedAnalytics Boolean  @default(false)
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([planId])
  @@map("individual_subscription_plans")
}

// ============================================================================
// 15.2 ORGANIZATION SUBSCRIPTION PLAN (Agency-level subscription)
// ============================================================================

model OrganizationSubscriptionPlan {
  id             String        @id @default(cuid())
  planId         String        @unique
  plan           SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  
  agencyId       String        @unique
  agency         Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  
  maxAgents      Int
  maxListingsActive Int
  maxAreas       Int
  hasTeamManagement Boolean    @default(true)
  hasAdvancedAnalytics Boolean @default(true)
  hasApiAccess    Boolean      @default(false)
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([agencyId])
  @@index([planId])
  @@map("organization_subscription_plans")
}

// ============================================================================
// 16. REFRESH TOKEN MODEL (Authentication)
// ============================================================================

model RefreshToken {
  id             String        @id @default(cuid())
  userId         String
  token          String        @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime      @default(now())

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
