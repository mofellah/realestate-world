{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@boilerplate/types": ["../../packages/types/src"],
      "@boilerplate/utils": ["../../packages/utils/src"],
      "@boilerplate/config": ["../../packages/config/src"],
      "@boilerplate/logger": ["../../packages/logger/src"]
    }
  },
  "include": ["src/**/*", "../../packages/**/*"]
}
